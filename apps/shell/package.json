{
  "name": "dsh-win7-shell",
  "productName": "DSH Win7",
  "version": "0.2.0",
  "private": true,
  "description": "Unofficial Electron 22 (Chromium 108) shell that runs the DeepSeek Harness web UI on Windows 7 SP1 x64.",
  "license": "MIT",
  "author": "dsh-win7 contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/MiG144/dsh-win7.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "electron-builder --config electron-builder.config.js --win --x64 --publish never",
    "dist:dir": "electron-builder --config electron-builder.config.js --win --x64 --dir"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  }
}
